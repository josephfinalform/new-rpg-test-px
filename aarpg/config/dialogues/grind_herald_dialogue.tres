lines = PackedStringArray("The Crystal Grind Pit echoes with the shatter of a thousand guardians.", "The Guardian reforms endlessly. Slay it again and again for double XP.", "Keep your COMBO alive, watch your health, and grow strong enough for the Shadow Keep.")
